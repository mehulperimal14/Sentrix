# SENTRIX configuration — copy to .env and edit.
#
# Only secrets and deployment-specific values live here. Every algorithmic
# threshold (evidence confirmation, level bands, dwell times, sliding windows)
# lives in sentrix/config.py, which is version-controlled and documented, so
# tuning is reviewable rather than buried in a local file.
#
# Defaults are safe: test mode is on, nothing is sent (two switches are needed,
# see "test mode and the send guard"), and every background service (SOS,
# link, channels, GPIO, node) is off until its flag is set. The Portal
# (python -m sentrix_portal) reads the PORTAL_* settings further down.
# tools/setup_env.py creates .env from this file with generated secrets.

# ─── required ─────────────────────────────────────────────────────────────────
# Local Console (device dashboard) password. The app refuses to authenticate
# anyone if this is unset. Portal accounts are separate and never reach the
# device (decision D14).
SENTRIX_PASSWORD=

# HMAC secret for session tokens. Without it, the signing key derives from the
# password alone, so every deployment sharing a password shares a key.
#   python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=

# ─── evidence encryption ──────────────────────────────────────────────────────
# Derives both the AES-256-GCM key and the manifest HMAC key via HKDF.
# If unset, an ephemeral key is generated and ALL evidence written this session
# becomes permanently unreadable when the process exits.
#   python -c "import secrets; print(secrets.token_hex(32))"
EVIDENCE_AES_KEY=

# ─── camera ───────────────────────────────────────────────────────────────────
# Comma-separated. Webcam index, RTSP/HTTP URL, or a video file path.
#   0                              laptop webcam
#   0,1                            two webcams, tiled
#   rtsp://user:pw@192.168.1.9/s1  IP camera or ESP32-S3 node
#   http://192.168.1.20:8080/video phone running an IP-webcam app
#   training/datasets/sentrix_custom/videos/gun.mov  a bundled video, looped
#   picamera:0                     Raspberry Pi camera (Picamera2)
#   demo-reel:<reel.json>          demo clips switched on request (tools/demo_run.py)
# The microphone opens unless SENTRIX_AUDIO=0 is set in the environment.
# Credentials in a camera URL are redacted (rtsp://***@host) in logs and pages.
CAMERA_SOURCES=0

# ─── server ───────────────────────────────────────────────────────────────────
# Defaults to loopback. Do NOT bind 0.0.0.0 without a reverse proxy and TLS.
SENTRIX_HOST=127.0.0.1
SENTRIX_PORT=8000
PUBLIC_SERVER_URL=http://127.0.0.1:8000

# Set to 1 when serving over HTTPS so the session cookie carries Secure.
SENTRIX_SECURE_COOKIES=0

# ─── retention ────────────────────────────────────────────────────────────────
# Days kept for reviewed L1-L3 incidents. L4-L5 and unreviewed incidents are
# kept longer, inside hard caps set in sentrix/config.py (RetentionConfig:
# unreviewed 180 d, TRUE verdicts 1 y, SOS snapshot 30 d, audit logs 1 y).
RETENTION_DAYS=30

# ─── test mode and the send guard (docs/7 §8.1, decision D13) ─────────────────
# Test mode is ON unless set to an explicit 0/false/no/off (anything else keeps
# it on), and is the only mode this semester. Nothing
# is ever sent unless SENTRIX_LIVE_ALERTS=1 AND the channel's own switch is 1;
# in test mode only to SENTRIX_TEST_RECIPIENTS (comma-separated E.164 numbers,
# e-mail addresses, tg:<chat id>), with a "[SENTRIX DEMO - TEST ...]" banner.
# SENTRIX never contacts 112 (or any emergency number) itself: those numbers
# are refused whatever the switches say. Refused messages are recorded as
# SUPPRESSED, so a demo still shows what would have been sent.
# SENTRIX_TEST_MODE=1
# SENTRIX_LIVE_ALERTS=0
# SENTRIX_TEST_RECIPIENTS=
# SENTRIX_MODEM_LIVE=0
# SENTRIX_TELEGRAM_LIVE=0
# SENTRIX_WHATSAPP_LIVE=0
# SENTRIX_EMAIL_LIVE=0

# ─── alerts (optional — falls back to console logging) ────────────────────────
# BREAKING (M10): the legacy L4 SMS / L5 call / "Send Now" via Twilio now needs
# SENTRIX_TWILIO_ENABLED=1 plus SENTRIX_LIVE_ALERTS=1 (and, in test mode,
# ALERT_PHONE_NUMBER in SENTRIX_TEST_RECIPIENTS). Keys alone send nothing.
# SENTRIX_TWILIO_ENABLED=0
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
ALERT_PHONE_NUMBER=

# ─── dispatch package details ─────────────────────────────────────────────────
SENTRIX_USER_NAME=
SENTRIX_USER_ADDRESS=
SENTRIX_USER_PHONE=
SENTRIX_CAMERA_LOCATION=Main Entrance

# ─── hardware (none is required on a laptop) ──────────────────────────────────
# auto | gpio | sound | console. "auto" picks the strongest backend available
# (since M10 it is honoured; it used to select the console stub).
SENTRIX_SIREN=auto
# Raspberry Pi 5: see deploy/pi5/README.md (CAMERA_SOURCES=picamera:0).
# Pi 5 (docs/7 §3, docs/8_RASPBERRY_PI5_INTEGRATION.md): every service is off unless switched on.
# SENTRIX_PROFILE=laptop          # laptop | pi5-clip | pi5-hailo | pi5-node | hub
# SENTRIX_GPIO_ENABLED=0          # gpiozero LEDs/inputs; mock pins off the Pi
# SENTRIX_GPIO_PIN_FACTORY=       # "" auto | lgpio | mock
# SENTRIX_SIREN_ACTIVE_HIGH=1     # NPN driver: HIGH = siren on; opto boards:
#                                 # 0, with gpio=17=op,dh in config.txt
# SENTRIX_SIREN_MAX_ON_SECONDS=90 # one relay on-period never exceeds this
# SENTRIX_SIREN_ARM_PIN=          # GPIO of the arming key's sense contact (to GND = armed)
# SENTRIX_SIREN_ARMED=1           # key position without that input; 0 refuses siren tests
# SENTRIX_TAMPER_PIN=             # enclosure lid switch (to GND = shut)
# SENTRIX_BUZZER_ENABLED=1        # local chirps on level rises
# SENTRIX_BUZZER_ACTIVE_HIGH=1    # 0 for a "low-level trigger" 3-pin buzzer module (else it sounds non-stop)
# SENTRIX_GPIO_INPUTS=pir,door,mains  # the inputs actually wired ("none" = none): an unwired
#                                 # PC817 reads "mains lost" and an unwired door reads "open"
# SENTRIX_NODE_ENABLED=0          # CPU temperature, throttling, 5 V, mains
# SENTRIX_SENSOR_BME280=0         # room sensors (kernel IIO drivers)
# SENTRIX_SENSOR_DHT22=0
# SENTRIX_PICAMERA_MAIN=1280x720  # Picamera2 main (evidence/preview) stream
# SENTRIX_PICAMERA_LORES=640x480  # Picamera2 lores (analysis) stream
# SENTRIX_PICAMERA_ROTATION=0     # 0 = upright with the ribbon connector at the bottom (the enclosure's mount); 180 for a module mounted connector-up
# SENTRIX_PIPELINE_MODE=tick      # tick | clip (4-second clip engine, docs/8_RASPBERRY_PI5_INTEGRATION.md T1)
# SENTRIX_FAST_LANE=0
# SENTRIX_RUNTIME=torch           # torch | onnx | ncnn (exports: tools/export_models.py)
# SENTRIX_SCENE_RUNTIME=          # per-model override of SENTRIX_RUNTIME for the scene classifier
# SENTRIX_CLIP_THREADS=4
# SENTRIX_CLIP_IMGSZ=640          # clip object stage on exported heads: 640 | 320 (needs that export)
# SENTRIX_CLIP_SCENE_KEYFRAMES=2  # scene-classifier frames per clip
# SENTRIX_FACE_MODEL=buffalo_l    # buffalo_s on the Pi

# ─── SOS, Portal link and channels (docs/7) ───────────────────────────────────
# SOS assistance requests at a confirmed L3 (weapon, fire; armed intrusion).
# SENTRIX_SOS_ENABLED=0
# SENTRIX_SOS_WINDOW_SECONDS=1800          # 1800 | 2700 | 3600 (profile overrides)
# SENTRIX_SOS_DEMO_WINDOW_SECONDS=0        # test mode only, >= 60
# SENTRIX_SOS_CONTACTS_SINGLE_SOURCE_L3=0  # stays 0 until gate P8 passes
# Outbound link to the Portal (the device never accepts inbound connections).
# SENTRIX_LINK_ENABLED=0
# SENTRIX_PORTAL_URL=http://portal.localhost:8100
# SENTRIX_DEVICE_IDENTITY_DIR=             # default /etc/sentrix, else var/link
# Channel router + outbox; USB 4G modem.
# SENTRIX_CHANNELS_ENABLED=0
# SENTRIX_MODEM_ENABLED=0
# SENTRIX_MODEM_PORT=                      # COM5 / /dev/ttyUSB2; "" = probe;
#                                          # mmcli (or mmcli:<index>) = ModemManager
# SENTRIX_TELEGRAM_MODE=polling            # polling (laptop) | webhook (VM); device and Portal
# The device sends Telegram/e-mail itself only without a Portal link
# (standalone); with a Portal, the Portal sends them.
# SENTRIX_EMAIL_PROVIDER=                  # brevo | resend (HTTPS API, not SMTP)
# Secrets for those channels (names only here, never commit values):
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_WEBHOOK_SECRET=
# BREVO_API_KEY=
# RESEND_API_KEY=
# SENTRIX_EMAIL_FROM=
# WhatsApp through Meta's Cloud API, sent by the Portal (D17; deploy/railway/README.md):
# WHATSAPP_ACCESS_TOKEN=                   # a system user's permanent token
# WHATSAPP_PHONE_NUMBER_ID=                # the sending number (Meta's test number)
# WHATSAPP_APP_SECRET=                     # checks the webhook's X-Hub-Signature-256
# WHATSAPP_VERIFY_TOKEN=                   # your own text for the webhook handshake
# WHATSAPP_WABA_ID=                        # tools/whatsapp_templates.py create | status
# WHATSAPP_MODE=template                   # template | session | auto (template, then session)
# WHATSAPP_TEMPLATE_LANG=en
# WHATSAPP_API_VERSION=v23.0
# SENTRIX_DESK_NUMBER=                     # shown instead of 112 in test mode
# Standalone LC (no Portal profile): the SOS PIN as an Argon2id hash
# (sentrix_portal.security.hash_pin). Unset = the LC PIN prompt accepts the
# console password instead.
# SENTRIX_SOS_PIN_HASH=
# Standalone device (no Portal): the owner's Telegram chat id / e-mail for
# SOS prompts (still behind both send switches and the test allowlist).
# SENTRIX_OWNER_TELEGRAM=
# SENTRIX_OWNER_EMAIL=
# Tests only: replay the first live session's log from another checkout.
# SENTRIX_LIVE_SESSION_LOG=G:/Sentrix/var/events/events_20260930_232502_c27258a25457.jsonl
# Move the whole var/ tree (database, events, evidence, snapshots, faces);
# the test suite points it at a temporary directory.
# SENTRIX_VAR_DIR=

# ─── Local Console web (docs/7 §9) ────────────────────────────────────────────
# SENTRIX_API_DOCS=0       # /docs, /redoc, /openapi.json (off by default since M10)
# SENTRIX_CSP=1
# SENTRIX_SETUP_MODE=0     # /setup/wifi exists only in physical setup mode

# ─── Portal (python -m sentrix_portal; docs/7 §3.5) ───────────────────────────
# PORTAL_DATABASE_URL=sqlite:///var/portal/portal.db
# PORTAL_SECRET_KEY=       # required when PORTAL_TEST_MODE=0; in test mode, generated
#                          # once into $PORTAL_DATA_DIR/secret_key (back it up)
# PORTAL_DATA_KEY=         # column encryption; same rule ($PORTAL_DATA_DIR/data_key)
# PORTAL_DATA_DIR=var/portal
# PORTAL_BASE_URL=http://portal.localhost:8100
# PORTAL_TEST_MODE=1
# PORTAL_HOST=127.0.0.1
# PORTAL_PORT=8100         # else the platform's PORT (Railway, Render), else 8100
# PORTAL_SECURE_COOKIES=0
# PORTAL_TRUSTED_PROXIES=127.0.0.1,::1   # "*" behind a platform edge (Railway: X-Real-IP)
# PORTAL_BOOTSTRAP_ADMIN=  # first company admin on a deploy without a shell (link in the log)
# PORTAL_RESET_ADMIN=      # a "set a new password" link for that company admin (link in the log)
# PORTAL_DESK_NUMBER=
# PORTAL_TELEGRAM_BOT_NAME=
# PORTAL_GRIEVANCE_CONTACT=    # the team's grievance address on the privacy notice
# PORTAL_API_DOCS=0
# PORTAL_WORKERS=0         # 1 = hub watcher, cloud SOS timers, notification worker, retention

# ─── tuning overrides (optional) ──────────────────────────────────────────────
# These shadow sentrix/config.py. Prefer editing config.py so changes are
# reviewed; use these for a quick experiment.
# SENTRIX_INFERENCE_FPS=6
# SENTRIX_PERSON_CONF=0.35
# SENTRIX_WEAPON_CONF=0.55
# SENTRIX_FIRE_CONF=0.50
# SENTRIX_LOITER_SECONDS=30
# SENTRIX_AUDIO_RMS_FLOOR=0.020

# Threat evidence (CLAUDE.md M1, D15). An unrecognised person is an L2
# ("suspicious": log and dashboard only, no snapshot, no SOS) in BOTH modes:
# after 3 s in armed mode, after SENTRIX_UNKNOWN_HOME_DWELL seconds at home.
# Levels 3-5 need a real threat (weapon, fire, a corroborated fight).
# SENTRIX_ARMED=0
# SENTRIX_UNKNOWN_ALERT_HOME=1          # 0 = home mode only logs unknown people
# SENTRIX_UNKNOWN_HOME_DWELL=10
# SENTRIX_SOS_INTRUSION=0               # 1 = pre-D15 armed-intrusion SOS request

# Audio (D15). auto = PANNs CNN10 AudioSet tagger (models/audio/) else the
# 4-class CNN; panns | cnn | off. Audio counts for a frame only when its 4 s
# window overlaps the frame time within the tolerance (else "unavailable").
# SENTRIX_AUDIO_MODEL=auto
# SENTRIX_AUDIO_ALIGN_TOLERANCE=1.5
# SENTRIX_AUDIO_THREADS=2
# A USB microphone plugged in (or back in) while SENTRIX runs is picked up
# without a restart: looked for every SENTRIX_MIC_RETRY_SECONDS; a connected one
# that sends nothing for SENTRIX_MIC_STALL_SECONDS counts as unplugged.
# SENTRIX_MIC_RETRY_SECONDS=5
# SENTRIX_MIC_STALL_SECONDS=5
# SENTRIX_AUDIO_VOTES=1                 # 0 = audio shown and logged, never scored
# SENTRIX_AUDIO_CALM_TALK_BENIGN=1      # very calm speech (strict bar) counts as banter
# A fight leaves L2 only with video + aligned aggression audio (3), or never (2).
# SENTRIX_FIGHT_MAX_LEVEL=3
# SENTRIX_FIGHT_MOTION_FLOOR=0.02

# Talk-down speaker (D16): off by default (it makes sound in the room).
# auto = pyttsx3 (Windows SAPI5 / espeak-ng) else the espeak-ng command.
# SENTRIX_SPEAKER_ENABLED=0
# SENTRIX_SPEAKER_BACKEND=auto          # auto | pyttsx3 | espeak | console
# SENTRIX_SPEAKER_DEVICE=               # ALSA device for espeak-ng, e.g. plughw:1,0
# SENTRIX_SPEAKER_VOLUME=0.9
# SENTRIX_SPEAKER_RATE=150
# SENTRIX_SPEAKER_PER_MINUTE=3
# Which video sources vote: both | scene | detector. Aligned audio votes in
# every mode (unless SENTRIX_AUDIO_VOTES=0), so a single video source plus a
# confirmed sound can still corroborate to L4; with audio off the single-source
# modes stop at L3. In detector mode the classifiers still vote for the
# experimental assault/robbery classes (capped at L2 without aggression audio).
# SENTRIX_THREAT_SOURCES=both
# Confirmation: a source must cross on K of the last N ticks.
# SENTRIX_CONFIRM_K=2
# SENTRIX_CONFIRM_N=3
# Per-deployment scene thresholds (JSON), e.g. after calibrating on this room.
# SENTRIX_SCENE_THRESHOLDS={"weapon": 0.55, "fire": 0.50}

# Face recognition cost (CLAUDE.md M2). 640 finds CCTV-distance faces; 320 is
# enough for a laptop webcam at < 2 m and about twice as fast. ORT threads are
# per face model; spin-waiting is always off.
# SENTRIX_FACE_DET_SIZE=640
# SENTRIX_FACE_ORT_THREADS=4

# Identity fail-closed. Leave at 1. Setting 0 lets a degraded face backend
# authorise people, which suppresses every alert — an authentication bypass.
# SENTRIX_IDENTITY_FAIL_CLOSED=1

# ─── custom dataset evaluation (tools/eval_custom_frames.py, replay_custom_videos.py)
# The frame dataset (labels.csv, train/, val/, test/), its 10 source videos and
# the reviewed ground truth all ship in training/datasets/sentrix_custom/
# (frames/, videos/). Set these only to evaluate on a copy stored elsewhere.
# SENTRIX_CUSTOM_DATASET=/path/to/dataset
# SENTRIX_CUSTOM_VIDEOS=/path/to/videos

# ─── teachers' demo (tools/demo_reset.py, tools/demo_run.py) ─────────────────
# Real team members' details for the demo household, read from the
# environment only (never committed). Without them fictional numbers are used.
# demo_run forces test mode and every live switch off.
# SENTRIX_DEMO_OWNER_PHONE=
# SENTRIX_DEMO_OWNER_EMAIL=
# SENTRIX_DEMO_CONTACT_PHONE=
# SENTRIX_DEMO_CONTACT_EMAIL=
# SENTRIX_DEMO_CONTACT_TELEGRAM=
