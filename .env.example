# SENTRIX configuration — copy to .env and edit.
#
# Only secrets and deployment-specific values live here. Every algorithmic
# threshold (level bands, dwell times, sliding windows, EMA time constant) lives
# in sentrix/config.py, which is version-controlled and documented, so tuning is
# reviewable rather than buried in a local file.

# ─── required ─────────────────────────────────────────────────────────────────
# Dashboard password. The app refuses to authenticate anyone if this is unset.
SENTRIX_PASSWORD=

# HMAC secret for session tokens. Without it, the signing key derives from the
# password alone, so every deployment sharing a password shares a key.
#   python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=

# ─── evidence encryption ──────────────────────────────────────────────────────
# Derives both the AES-256-GCM key and the manifest HMAC key via HKDF.
# If unset, an ephemeral key is generated and ALL evidence written this session
# becomes permanently unreadable when the process exits.
#   python -c "import secrets; print(secrets.token_hex(32))"
EVIDENCE_AES_KEY=

# ─── camera ───────────────────────────────────────────────────────────────────
# Comma-separated. Webcam index, RTSP/HTTP URL, or a video file path.
#   0                              laptop webcam
#   0,1                            two webcams, tiled
#   rtsp://user:pw@192.168.1.9/s1  IP camera or ESP32-S3 node
#   http://192.168.1.20:8080/video phone running an IP-webcam app
CAMERA_SOURCES=0

# ─── server ───────────────────────────────────────────────────────────────────
# Defaults to loopback. Do NOT bind 0.0.0.0 without a reverse proxy and TLS.
SENTRIX_HOST=127.0.0.1
SENTRIX_PORT=8000
PUBLIC_SERVER_URL=http://127.0.0.1:8000

# Set to 1 when serving over HTTPS so the session cookie carries Secure.
SENTRIX_SECURE_COOKIES=0

# ─── retention ────────────────────────────────────────────────────────────────
# Level 4-5 incidents and any incident awaiting operator review are never pruned.
RETENTION_DAYS=30

# ─── test mode and the send guard (docs/7 §8.1, decision D13) ─────────────────
# Test mode is ON unless set to 0, and is the only mode this semester. Nothing
# is ever sent unless SENTRIX_LIVE_ALERTS=1 AND the channel's own switch is 1;
# in test mode only to SENTRIX_TEST_RECIPIENTS (comma-separated E.164 numbers,
# e-mail addresses, tg:<chat id>), with a "[SENTRIX DEMO - TEST ...]" banner.
# SENTRIX never contacts 112 (or any emergency number) itself.
# SENTRIX_TEST_MODE=1
# SENTRIX_LIVE_ALERTS=0
# SENTRIX_TEST_RECIPIENTS=
# SENTRIX_MODEM_LIVE=0
# SENTRIX_TELEGRAM_LIVE=0
# SENTRIX_EMAIL_LIVE=0

# ─── alerts (optional — falls back to console logging) ────────────────────────
# BREAKING (M10): the legacy L4 SMS / L5 call / "Send Now" via Twilio now needs
# SENTRIX_TWILIO_ENABLED=1 plus SENTRIX_LIVE_ALERTS=1 (and, in test mode,
# ALERT_PHONE_NUMBER in SENTRIX_TEST_RECIPIENTS). Keys alone send nothing.
# SENTRIX_TWILIO_ENABLED=0
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
ALERT_PHONE_NUMBER=

# ─── dispatch package details ─────────────────────────────────────────────────
SENTRIX_USER_NAME=
SENTRIX_USER_ADDRESS=
SENTRIX_USER_PHONE=
SENTRIX_CAMERA_LOCATION=Main Entrance

# ─── hardware (for later — no hardware is required today) ─────────────────────
# auto | gpio | sound | console. "auto" picks the strongest backend available.
SENTRIX_SIREN=auto
# Pi 5 (docs/7 §3, HARDWARE.md): every service is off unless switched on.
# SENTRIX_PROFILE=laptop          # laptop | pi5-clip | pi5-hailo | pi5-node | hub
# SENTRIX_GPIO_ENABLED=0          # gpiozero LEDs/inputs; mock pins off the Pi
# SENTRIX_GPIO_PIN_FACTORY=       # "" auto | lgpio | mock
# SENTRIX_SIREN_ACTIVE_HIGH=1     # NPN driver: HIGH = siren on
# SENTRIX_NODE_ENABLED=0          # CPU temperature, throttling, 5 V, mains
# SENTRIX_PIPELINE_MODE=tick      # tick | clip (4-second clip engine, HARDWARE.md T1)
# SENTRIX_FAST_LANE=0
# SENTRIX_RUNTIME=torch           # torch | onnx | ncnn
# SENTRIX_CLIP_THREADS=4
# SENTRIX_FACE_MODEL=buffalo_l    # buffalo_s on the Pi

# ─── SOS, Portal link and channels (docs/7) ───────────────────────────────────
# SOS assistance requests at a confirmed L3 (weapon, fire; armed intrusion).
# SENTRIX_SOS_ENABLED=0
# SENTRIX_SOS_WINDOW_SECONDS=1800          # 1800 | 2700 | 3600 (profile overrides)
# SENTRIX_SOS_DEMO_WINDOW_SECONDS=0        # test mode only, >= 60
# SENTRIX_SOS_CONTACTS_SINGLE_SOURCE_L3=0  # stays 0 until gate P8 passes
# Outbound link to the Portal (the device never accepts inbound connections).
# SENTRIX_LINK_ENABLED=0
# SENTRIX_PORTAL_URL=http://portal.localhost:8100
# SENTRIX_DEVICE_IDENTITY_DIR=             # default /etc/sentrix, else var/link
# Channel router + outbox; USB 4G modem.
# SENTRIX_CHANNELS_ENABLED=0
# SENTRIX_MODEM_ENABLED=0
# SENTRIX_MODEM_PORT=                      # COM5 / /dev/ttyUSB2; "" = probe
# SENTRIX_TELEGRAM_MODE=polling            # polling (laptop) | webhook (VM)
# SENTRIX_EMAIL_PROVIDER=                  # brevo | resend (HTTPS API, not SMTP)
# Secrets for those channels (names only here, never commit values):
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_WEBHOOK_SECRET=
# BREVO_API_KEY=
# RESEND_API_KEY=
# SENTRIX_EMAIL_FROM=
# SENTRIX_DESK_NUMBER=                     # shown instead of 112 in test mode
# Standalone LC (no Portal profile): the SOS PIN as an Argon2id hash
# (sentrix_portal.security.hash_pin). Unset = the LC PIN prompt accepts the
# console password instead.
# SENTRIX_SOS_PIN_HASH=

# ─── Local Console web (docs/7 §9) ────────────────────────────────────────────
# SENTRIX_API_DOCS=0       # /docs, /redoc, /openapi.json (off by default since M10)
# SENTRIX_CSP=1
# SENTRIX_SETUP_MODE=0     # /setup/wifi exists only in physical setup mode

# ─── Portal (python -m sentrix_portal; docs/7 §4) ─────────────────────────────
# PORTAL_DATABASE_URL=sqlite:///var/portal/portal.db
# PORTAL_SECRET_KEY=       # required when PORTAL_TEST_MODE=0; in test mode, generated
#                          # once into $PORTAL_DATA_DIR/secret_key (back it up)
# PORTAL_DATA_KEY=         # column encryption; same rule ($PORTAL_DATA_DIR/data_key)
# PORTAL_DATA_DIR=var/portal
# PORTAL_BASE_URL=http://portal.localhost:8100
# PORTAL_TEST_MODE=1
# PORTAL_HOST=127.0.0.1
# PORTAL_PORT=8100
# PORTAL_SECURE_COOKIES=0
# PORTAL_TRUSTED_PROXIES=127.0.0.1,::1
# PORTAL_DESK_NUMBER=
# PORTAL_TELEGRAM_BOT_NAME=
# PORTAL_API_DOCS=0
# PORTAL_WORKERS=0         # 1 = hub watcher, cloud SOS timers, notification worker, retention

# ─── tuning overrides (optional) ──────────────────────────────────────────────
# These shadow sentrix/config.py. Prefer editing config.py so changes are
# reviewed; use these for a quick experiment.
# SENTRIX_INFERENCE_FPS=6
# SENTRIX_PERSON_CONF=0.35
# SENTRIX_WEAPON_CONF=0.55
# SENTRIX_FIRE_CONF=0.50
# SENTRIX_LOITER_SECONDS=30
# SENTRIX_AUDIO_RMS_FLOOR=0.020

# Threat evidence (CLAUDE.md M1). Armed mode turns a person who stays
# unrecognised for 3 s into an L3 intrusion; home mode (default) only logs them.
# SENTRIX_ARMED=0
# Which sources vote: both | scene | detector. The single-source modes can
# never corroborate, so they stop at L3; in detector mode the classifiers still
# vote for the experimental assault/robbery classes (capped at L2).
# SENTRIX_THREAT_SOURCES=both
# Confirmation: a source must cross on K of the last N ticks.
# SENTRIX_CONFIRM_K=2
# SENTRIX_CONFIRM_N=3
# Per-deployment scene thresholds (JSON), e.g. after calibrating on this room.
# SENTRIX_SCENE_THRESHOLDS={"weapon": 0.55, "fire": 0.50}

# Face recognition cost (CLAUDE.md M2). 640 finds CCTV-distance faces; 320 is
# enough for a laptop webcam at < 2 m and about twice as fast. ORT threads are
# per face model; spin-waiting is always off.
# SENTRIX_FACE_DET_SIZE=640
# SENTRIX_FACE_ORT_THREADS=4

# Identity fail-closed. Leave at 1. Setting 0 lets a degraded face backend
# authorise people, which suppresses every alert — an authentication bypass.
# SENTRIX_IDENTITY_FAIL_CLOSED=1

# ─── custom dataset evaluation (tools/eval_custom_frames.py, replay_custom_videos.py)
# The frame dataset (labels.csv, train/, val/, test/), its 10 source videos and
# the reviewed ground truth all ship in training/datasets/sentrix_custom/
# (frames/, videos/). Set these only to evaluate on a copy stored elsewhere.
# SENTRIX_CUSTOM_DATASET=/path/to/dataset
# SENTRIX_CUSTOM_VIDEOS=/path/to/videos
