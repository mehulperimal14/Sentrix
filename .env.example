# .env.example
# SENTRIX Environment Configuration
# Copy to .env and fill in your values

# ─── General ──────────────────────────────────────────────────────────────────
PUBLIC_SERVER_URL=http://127.0.0.1:8000
CAMERA_SOURCES=0          # Comma-separated: int (webcam index) or RTSP URL
SENTRIX_PASSWORD=admin    # Change before deployment

# ─── Session Security (REQUIRED for production) ───────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=

# ─── Data Retention (Optional) ────────────────────────────────────────────────
RETENTION_DAYS=30         # Auto-prune events/snapshots older than N days (Level 4/5 kept forever)

# ─── Cloud Threat Detection (Optional) ───────────────────────────────────────
# Falls back to local heuristics if empty
ROBOFLOW_API_KEY=

# ─── Twilio Alerts (Optional) ─────────────────────────────────────────────────
# Falls back to console printing if empty
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
ALERT_PHONE_NUMBER=

# ─── Evidence Encryption (Optional) ──────────────────────────────────────────
# Must be at least 32 hex characters (16 bytes). Set this to keep evidence
# readable across restarts. Auto-generates ephemeral key if empty (demo mode).
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
EVIDENCE_AES_KEY=

# ─── Dispatch User Information ────────────────────────────────────────────────
SENTRIX_USER_NAME=John Doe
SENTRIX_USER_ADDRESS=123 Secure Lane, Tech City, TC 10101
SENTRIX_USER_PHONE=+1234567890
SENTRIX_CAMERA_LOCATION=Main Entrance

# ─── Voice SOS (Optional) ─────────────────────────────────────────────────────
VOSK_MODEL_PATH=vosk-model
