# Normalise text to LF in the repository; check out with native line endings,
# except the launch scripts, whose interpreters need their own.
* text=auto
*.sh  text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf

# Weights, media and documents are binary: never diff or convert them.
*.pt    binary
*.pth   binary
*.onnx  binary
*.engine binary
*.mov   binary
*.mp4   binary
*.avi   binary
*.wav   binary
*.jpg   binary
*.jpeg  binary
*.png   binary
*.pdf   binary
*.docx  binary
*.npz   binary
*.npy   binary
*.mat   binary
*.fst   binary
*.mdl   binary
*.ie    binary
*.dubm  binary
