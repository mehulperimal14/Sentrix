# Raspberry Pi 5 defaults. install_pi.sh appends every key below that .env
# does not set yet; values already in .env are never changed. One KEY=value
# per line, comments on their own lines.

# Hardware profile (docs/8_RASPBERRY_PI5_INTEGRATION.md §9): pi5-clip | pi5-hailo | pi5-node | hub
SENTRIX_PROFILE=pi5-clip

# Camera Module 3 through Picamera2 (OpenCV cannot open it on a Pi 5).
# Main 1280x720 for preview/evidence, lores 640x480 for analysis.
CAMERA_SOURCES=picamera:0
SENTRIX_CAPTURE_FPS=15

# Local Console on the LAN only: ufw (deploy/pi5/ufw.sh) admits the LAN and
# nothing else. Plain HTTP on the LAN is accepted for the demo; say so.
SENTRIX_HOST=0.0.0.0
SENTRIX_PORT=8000

# Siren relay through an NPN driver: active-high; config.txt gpio=17=op,dl.
SENTRIX_SIREN=gpio
SENTRIX_SIREN_ACTIVE_HIGH=1
SENTRIX_SIREN_MAX_ON_SECONDS=90
SENTRIX_GPIO_ENABLED=1
SENTRIX_GPIO_PIN_FACTORY=lgpio

# Board telemetry (temperature, throttling, EXT5V, mains) for the Node page.
SENTRIX_NODE_ENABLED=1

# The small face model (re-embeds the gallery on first start).
SENTRIX_FACE_MODEL=buffalo_s

# Identity written by tools/provision_device.py, outside var/.
SENTRIX_DEVICE_IDENTITY_DIR=/etc/sentrix

# The 4-second clip engine (docs/8_RASPBERRY_PI5_INTEGRATION.md T1) on exported models. Exports are
# built on the laptop (python tools/export_models.py --scene [--ncnn]) and
# copied to models/exported/; a missing export falls back to torch.
SENTRIX_PIPELINE_MODE=clip
SENTRIX_RUNTIME=onnx
SENTRIX_FAST_LANE=1
SENTRIX_FACE_DET_SIZE=320
# The clip's object stage at 320 px: a clip in ~3.9 s on a Pi 5 instead of
# ~8 s at 640, same L3 recall on the train + val replays
# (training/runs/custom_eval/pi5/REPORT.md).
SENTRIX_CLIP_IMGSZ=320

# Test mode is the only mode this semester (D13): nothing is sent outside
# SENTRIX_TEST_RECIPIENTS, and only with both live switches (left off here).
SENTRIX_TEST_MODE=1
SENTRIX_LIVE_ALERTS=0

# Assistance requests (SOS) and the channel router (LC prompt, modem SMS).
# The modem worker starts only with SENTRIX_MODEM_ENABLED=1 (Tier 1).
SENTRIX_SOS_ENABLED=1
SENTRIX_CHANNELS_ENABLED=1
SENTRIX_MODEM_ENABLED=0

# Link to the Portal (docs/7 §5, deploy/portal/README.md): set
# SENTRIX_PORTAL_URL=https://portal.<your-domain>.in and SENTRIX_LINK_ENABLED=1
# once the device is provisioned (identity in /etc/sentrix) and the Portal is up.
SENTRIX_LINK_ENABLED=0
SENTRIX_PORTAL_URL=
