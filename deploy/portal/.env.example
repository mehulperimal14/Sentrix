# SENTRIX Portal deployment - copy to .env next to docker-compose.yml and fill in.
# NAMES ONLY in git: never commit a filled-in .env. Test mode stays ON this
# semester (D13): nothing reaches anyone outside SENTRIX_TEST_RECIPIENTS, and
# only with both live switches, which stay 0 here.

# ── public address (Caddy, Let's Encrypt) ─────────────────────────────────────
PORTAL_DOMAIN=
ACME_EMAIL=
# PORTAL_BASE_URL is set by docker-compose.yml to https://$PORTAL_DOMAIN

# ── database (Postgres 16 on the internal network) ────────────────────────────
POSTGRES_DB=sentrix
POSTGRES_USER=sentrix
POSTGRES_PASSWORD=

# ── keys (required when PORTAL_TEST_MODE=0; back them up, see README) ────────
#   python -c "import secrets; print(secrets.token_hex(32))"
PORTAL_SECRET_KEY=
PORTAL_DATA_KEY=

# ── mode (D13): test mode on, live sending off ───────────────────────────────
PORTAL_TEST_MODE=1
SENTRIX_TEST_MODE=1
SENTRIX_LIVE_ALERTS=0
SENTRIX_TELEGRAM_LIVE=0
SENTRIX_EMAIL_LIVE=0
SENTRIX_WEBPUSH_LIVE=0
SENTRIX_TEST_RECIPIENTS=
SENTRIX_SOS_DEMO_WINDOW_SECONDS=

# ── people and wording ────────────────────────────────────────────────────────
PORTAL_DESK_NUMBER=
PORTAL_GRIEVANCE_CONTACT=
PORTAL_TELEGRAM_BOT_NAME=

# ── channels (HTTPS APIs only; SMTP is blocked on Render and not used) ───────
SENTRIX_TELEGRAM_MODE=webhook
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
SENTRIX_EMAIL_PROVIDER=
BREVO_API_KEY=
RESEND_API_KEY=
SENTRIX_EMAIL_FROM=

# ── misc ──────────────────────────────────────────────────────────────────────
PORTAL_API_DOCS=0
PORTAL_LOG_LEVEL=warning
