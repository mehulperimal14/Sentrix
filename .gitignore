# ── secrets ───────────────────────────────────────────────────────────────────
# .env holds the dashboard password, the evidence key and Twilio credentials.
# Only the blank template is tracked.
.env
.env.*
!.env.example
*.pem
*.key

# ── runtime output ────────────────────────────────────────────────────────────
# Everything the running system produces. Never commit this: the previous
# layout accumulated 642 MB of alert snapshots and evidence bundles inside
# backend/runtime/ and 2,801 of those files were committed to the repository.
var/

# ── python ────────────────────────────────────────────────────────────────────
.venv/
venv/
ENV/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# ── notebooks ─────────────────────────────────────────────────────────────────
.ipynb_checkpoints/

# ── datasets ──────────────────────────────────────────────────────────────────
# Raw and preprocessed public corpora stay out of git. Record provenance in
# docs/ and the sample manifests under training/runs/ instead. The one
# exception is the team's custom dataset (frames + 10 source videos, ~140 MB),
# tracked under training/datasets/sentrix_custom/ so every evaluation in
# docs/6 reproduces on a fresh clone.
data/
training/cache_ucf_crime_dvs/
training/ucf_crime_dvs/
*.npz
*.npy

# ── large training artefacts ──────────────────────────────────────────────────
# Checkpoints are tracked deliberately (the deployed weights live in models/),
# but intermediate epoch dumps are not.
training/runs/**/last.pt
training/runs/**/epoch*.pt

# ── OS ────────────────────────────────────────────────────────────────────────
.DS_Store
.AppleDouble
Thumbs.db
desktop.ini

# ── editors and local tooling ─────────────────────────────────────────────────
.vscode/
.idea/
*.swp
.claude/
.mypy_cache/
.tox/
.cache/
*.log

# ── device-specific exports ───────────────────────────────────────────────────
# TensorRT engines and OpenVINO folders are built per machine from the tracked
# .pt weights; they do not transfer between GPUs or driver versions.
*.engine
*_openvino_model/

# per-run weight dumps of custom-dataset detector training; the promoted
# copy lives in models/
training/runs/custom/detector/*/weights/

# your own evaluation runs (tools/*.py --tag <name>); the published runs that
# docs/6 and CLAUDE.md quote stay tracked
training/runs/custom_eval/*
!training/runs/custom_eval/baseline/
!training/runs/custom_eval/custom/
!training/runs/custom_eval/finetuned/
!training/runs/custom_eval/m1/
!training/runs/custom_eval/m5/
!training/runs/custom_eval/m11/
!training/runs/custom_eval/m11_homelog/
!training/runs/custom_eval/m11b/
!training/runs/custom_eval/m11b_homelog/

# ── stray outputs ─────────────────────────────────────────────────────────────
# Ultralytics downloads base weights into the working directory and writes runs/
# there by default; the weights SENTRIX uses are tracked under models/.
/*.pt
/runs/
# runtime databases and event logs written outside var/ by mistake
*.db
*.sqlite
*.sqlite3
*.jsonl
# other local environments and tooling
.venv*/
venv*/
.python-version
coverage.xml
CLAUDE.local.md
# Office lock files (docs/capstone/)
~$*
